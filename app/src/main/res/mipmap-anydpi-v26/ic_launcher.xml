<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, API 26+. The launcher masks the background to whatever shape the device uses,
  so the mark must stay inside the 72dp safe zone of the 108dp foreground — it does.
  API 24 and 25 fall back to the flat PNGs in mipmap-<density>/ic_launcher.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Android 13+ themed icons: the system tints this to the wallpaper. Without it the
         icon is the one on the home screen that ignores the user's theme. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
