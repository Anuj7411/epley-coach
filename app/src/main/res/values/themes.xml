<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Day. windowBackground is the bone ground, so the frame the system paints before Compose
      draws matches the first screen instead of flashing a different colour.
    -->
    <style name="Theme.Epley" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#EFEDE8</item>
        <item name="android:navigationBarColor">#EFEDE8</item>
        <item name="android:windowBackground">#EFEDE8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
