<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Epley" parent="android:Theme.Material.NoActionBar">
        <!--
          Palette.Ground, not #000000. docs/DESIGN.md rules out pure black: off-white text on it
          causes halation, worst with astigmatism. This colour is also what the system paints
          before the first frame and behind the splash, so a wrong value here shows as a flash
          of a different dark on every cold start.
        -->
        <item name="android:statusBarColor">#121311</item>
        <item name="android:windowBackground">#121311</item>
    </style>

</resources>
