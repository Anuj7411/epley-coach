<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ draws a splash on every cold start whether or not you configure it. Left alone
      it uses the launcher icon on the window background — the ink-on-lilac icon dropped onto
      near-black.

      Deliberately lilac-on-ink rather than the icon's ink-on-lilac. The logo kit allows both
      pairings, and this one keeps the cold start dark the whole way: a full-screen flash of
      bright lilac ahead of a near-black app is the glare the design rules exist to avoid, and
      this audience is mid-attack.

      These attributes are inert outside the splash, so they sit on the app's own theme rather
      than needing a second theme and the androidx splashscreen library to hand back afterwards.
    -->
    <style name="Theme.Epley" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#121311</item>
        <item name="android:windowBackground">#121311</item>
        <item name="android:windowSplashScreenBackground">#121311</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
