        <group android:scaleX="1.02" android:scaleY="1.02">
            <group android:translateX="-135" android:translateY="-128">
                <group android:translateX="-4" android:translateY="12">
                    <path
                        android:pathData="M60,116 H172 A56,56 0 1 0 116,172 H218"
                        android:strokeWidth="26"
                        android:strokeColor="#FFFFFFFF"
                        android:fillColor="#00000000" />
                </group>
            </group>
        </group>
