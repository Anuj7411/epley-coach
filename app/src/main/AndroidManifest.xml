<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared but not required: a device without a gyroscope can still install the app, and we
      detect the missing sensor at startup and say so plainly rather than reporting a wrong angle.
      Some budget Android phones ship without one.
    -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <!-- Haptic cues: the only signal that reaches someone face-down with their eyes shut. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      A phone held against a cheek looks like a pocket, so the display sleeps even with the
      keep-screen-on flag. Non-wakeup sensors stop when the processor suspends, which would stall
      the manoeuvre mid-position. Held only while the app is in the foreground.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Since Android 11, an app must declare it looks for a text-to-speech engine or it cannot bind
      to one, and speech silently does nothing. That failure would only show up on the manoeuvre's
      hardest position, so it is worth this comment.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Epley Coach"
        android:supportsRtl="true"
        android:theme="@style/Theme.Epley">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Epley Coach"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Epley">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
